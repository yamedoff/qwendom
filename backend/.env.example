# Provider: "qwen" (default) or "openrouter"
LLM_PROVIDER=qwen

# Qwen Cloud (default provider)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
# Optional dedicated DashScope key for media calls. When blank, media routing
# falls back to QWEN_API_KEY because this app uses the same Singapore account.
DASHSCOPE_API_KEY=
# The default above remains valid for both the LLM path and media fallback.
# Override only when routing text traffic through a different approved
# Singapore DashScope-compatible endpoint.
ALLOW_DETERMINISTIC_NO_KEY=false

# AgentBay Phase 0 static configuration. Leave credentials blank locally until
# the Singapore account is provisioned.
AGENTBAY_API_KEY=
AGENTBAY_ENDPOINT=wuyingai.ap-southeast-1.aliyuncs.com
AGENTBAY_REGION_ID=ap-southeast-1
AGENTBAY_IMAGE_ID=code_latest
AGENTBAY_BROWSER_IMAGE_ID=browser_latest
# Optional performance/stability override. When blank, media calls derive the
# Singapore DashScope service root from QWEN_BASE_URL.
MODEL_STUDIO_WORKSPACE_ID=
# Optional explicit media base override. Accepted forms:
# https://dashscope-intl.aliyuncs.com/api/v1
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/api/v1
MODEL_STUDIO_BASE_URL=
QWEN_IMAGE_MODEL=qwen-image-2.0-pro-2026-06-22
WAN_VIDEO_MODEL=wan2.7-t2v-2026-06-12

# OpenRouter (set LLM_PROVIDER=openrouter to use)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

LLM_TIMEOUT_SECONDS=60
READINESS_CONCURRENCY=3
EFFICIENT_SOCIETY_ENABLED=true
BENCHMARK_SUITE_TOOLS_ENABLED=false
# Fixed-specialist composition is the production default. Setting this false
# only disables explicitly selected legacy-composer execution; fixed-specialist
# missions fail truthfully if they cannot compose or execute.
TEAM_COMPOSITION_EXECUTION_ENABLED=true
SOCIETY_MAX_MODEL_WORKERS=4
SOCIETY_MAX_AGENTBAY_SESSIONS=3
SOCIETY_MAX_MEDIA_JOBS=2
SOCIETY_MAX_DYNAMIC_SPECIALISTS=5
AGENTBAY_SESSION_TIMEOUT_SECONDS=1800
VIDEO_JOB_TIMEOUT_SECONDS=600
# Leave blank for the normal product event store. Benchmark runners override it.
EVENT_STORE_FILE=
FRONTEND_ORIGIN=http://localhost:5173
